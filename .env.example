# ReelTalk instance configuration.
# Copy to .env, then run ./setup.sh to generate the secrets and fill in DOMAIN.
# Uncomment when changing default values.

# --- Required (setup.sh generates the two secrets) ---

DOMAIN=your-instance.example.com
SECRET_KEY=
POSTGRES_PASSWORD=

# Postgres connection (these defaults match the docker compose layout)
POSTGRES_USER=reeltalk
POSTGRES_DB=reeltalk
POSTGRES_HOST=db

# --- Web endpoint ---
# Default is 3030

# WEB_PORT=3030

# The host interface the published port binds to. Unset (default) publishes
# on every interface, which is what a deploy with no local reverse proxy
# needs. Set 127.0.0.1 when a proxy on this same host fronts the app and
# nothing off this machine should reach the app port.

# WEB_BIND=127.0.0.1

# Origins allowed to submit forms (CSRF). Needed when you reach the instance
# via hosts other than DOMAIN, e.g. a LAN IP or an extra domain:

# CSRF_TRUSTED_ORIGINS=http://<IP-ADDRESS>:3030,https://reeltalk.example.com

# --- Proxy trust (TRUSTED_PROXIES) ---
# Shipped default is the private ranges, so a proxy on your LAN or on the
# docker compose network needs no value here at all. Set it only to name a
# proxy outside those ranges. The example address below is from the RFC 5737
# documentation range: replace it with your real proxy address, because an
# unparsed placeholder here stops the app at startup with an invalid CIDR.
# Setting it explicitly EMPTY means "no proxy in front of us": nothing
# forwarded is believed and every request resolves to its real peer.
# The proxy must forward X-Forwarded-Proto: https and the original Host header.

# TRUSTED_PROXIES=203.0.113.10/32

# --- LAN federation peers (FEDERATION_ALLOWED_NETWORKS) ---
# Every outbound fetch (federation, TMDB, image mirrors) dials only publicly
# routable addresses: loopback, private, and cloud metadata destinations are
# refused. If a federation peer genuinely shares your network, name its
# CIDRs here, comma-separated. Anything not listed stays refused, and
# listing a LAN range never reopens the metadata addresses.

# FEDERATION_ALLOWED_NETWORKS=192.168.1.0/24

# Session/CSRF cookies carry the Secure flag (default true) so they are never
# sent over a channel that isn't encrypted.

# SECURE_COOKIES=true

# With SECURE_COOKIES on, the flag follows the request scheme (default true).
# Set false for the strict posture, where Secure is unconditional
# -- which also means plain HTTP login cannot work anywhere, the LAN included.

# COOKIES_FOLLOW_SCHEME=true

# --- Canonical federation origin ---
# The origin every ActivityPub identity is minted from.
# Defaults to https://DOMAIN.

# CANONICAL_ORIGIN=https://reeltalk.example.com

# --- TMDB (optional) ---
# Get a free API key at https://www.themoviedb.org/settings/api
# When unset, film search falls back to the local library only.

# REELTALK_TMDB_API_KEY=

# --- Email (optional; console backend when unset) ---
# EMAIL_SENDER_NAME and EMAIL_SENDER_DOMAIN must be the two halves of
# EMAIL_HOST_USER on mail servers that refuse a sender that is not the
# authenticated account. Left unset, the From address is minted on DOMAIN.

# EMAIL_HOST=localhost
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_SENDER_NAME=admin
# EMAIL_SENDER_DOMAIN=

# --- Prebuilt image version (docker-compose.prebuilt.yml only) ---
# The prebuilt path pins this exact tag instead of tracking a moving target,
# so an upgrade is a deliberate edit you can roll back by changing it.
# Tags on the registry carry no leading "v": use 0.1.0, not v0.1.0.
# Defaults to the value below when unset, so you can leave this alone.

# REELTALK_VERSION=0.1.0

# --- Optional overrides ---

# DEBUG=false
# ALLOWED_HOSTS=localhost,127.0.0.1   # defaults to DOMAIN; add extra hostnames here if needed
# POSTGRES_SHM_SIZE=128mb
# DATA_UPLOAD_MAX_MEMORY_MiB=100
# TIME_ZONE=UTC

# Public HTTPS-only deployments can enable these after validating proxy trust.
# COOKIES_FOLLOW_SCHEME=false
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=86400
# With SECURE_SSL_REDIRECT on, the compose healthcheck must keep its
# X-Forwarded-Proto: https header (shipped in both compose files): without
# it the plain-HTTP probe inside the container takes a 301 and the service
# reads unhealthy forever.
