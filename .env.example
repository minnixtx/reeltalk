# ReelTalk instance configuration.
# Copy to .env, then run ./setup.sh to generate the secrets and fill in DOMAIN.

# --- Required (setup.sh generates the two secrets) ---
DOMAIN=your-instance.example.com
SECRET_KEY=
POSTGRES_PASSWORD=

# Postgres connection (these defaults match the docker compose layout)
POSTGRES_USER=reeltalk
POSTGRES_DB=reeltalk
POSTGRES_HOST=db

# --- Web endpoint ---
# The web container serves the site and static/media itself (uvicorn +
# whitenoise) on a plain-HTTP endpoint at this port (no TLS). Terminate TLS
# yourself and point your own reverse proxy at <host>:WEB_PORT.
# WEB_PORT=3030
# Origins allowed to submit forms (CSRF). Needed when you reach the instance
# via hosts other than DOMAIN, e.g. a LAN IP or an extra domain:
# CSRF_TRUSTED_ORIGINS=http://192.168.1.50:3030,https://reeltalk.example.com

# --- TLS terminator trust ---
# Your reverse proxy tells the app a request arrived over https with
# X-Forwarded-Proto. Django believes that header from ANY client, so list the
# address(es) of the proxy that actually sends it here — comma-separated IPs or
# CIDRs. Leaving it empty means "no proxy": the forwarded scheme is ignored and
# the app reports the real transport scheme.
#   TRUSTED_PROXIES=192.168.1.141/32
# The proxy must forward X-Forwarded-Proto: https and the original Host header.
#
# Session/CSRF cookies carry the Secure flag (default true) so they are never
# sent over a channel that isn't encrypted.
# SECURE_COOKIES=true
# With SECURE_COOKIES on, the flag follows the request scheme (default true):
# a request that arrived over https gets Secure cookies, a plain-HTTP one does
# not. That is what lets the same instance serve both the public https domain
# and a plain http://<lan-ip>:3030 you can actually log into. Set false for
# the strict posture, where Secure is unconditional -- which also means plain
# HTTP login cannot work anywhere, the LAN included.
# COOKIES_FOLLOW_SCHEME=true

# --- TMDB (optional) ---
# Get a free API key at https://www.themoviedb.org/settings/api
# When unset, film search falls back to the local library only.
# REELTALK_TMDB_API_KEY=

# --- Email (optional; console backend when unset) ---
# EMAIL_HOST=localhost
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_SENDER_NAME=admin
# EMAIL_SENDER_DOMAIN=          # defaults to DOMAIN

# --- Optional overrides ---
# DEBUG=false
# ALLOWED_HOSTS=localhost,127.0.0.1   # defaults to DOMAIN; add extra hostnames here if needed
# POSTGRES_SHM_SIZE=128mb
# DATA_UPLOAD_MAX_MEMORY_MiB=100
# TIME_ZONE=UTC

# --- Database backups (the `backup` service) ---
# Dumps the DB once a day at this time (HH:MM in TIME_ZONE, default UTC) into the
# backups volume, keeping the newest N dumps. Restore one with:
#   pg_restore -d reeltalk <dump file>
# BACKUP_TIME=03:17
# BACKUP_RETENTION=7
# BACKUP_DIR=/app/backups   # defaults to the backups named volume
