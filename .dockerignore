.git
.qwen
# Never bake an instance's secrets into a published image. `.env.example` is the
# template and stays; every real env file is excluded, whatever it is named.
.env
.env.*
!.env.example
.coverage
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
node_modules/
exports/
backups/
# Repo-page artwork only (the README banner). Nothing in the app reads it, and
# `COPY . /app/` would otherwise bake ~3MB into every published image.
assets/
images/*
!images/.gitkeep
# Working notes, not deployer docs. They carry this project's own hostnames,
# addresses, and audit detail, and `COPY . /app/` would bake all of it into
# every published image.
DEPLOYING.md
PLAN.md
PROGRESS.md
SECURITY-AUDIT.md
SECURITY-HANDOFF.md
SETUP-HANDOFF.md
security-plan.md
NAVIGATION_REDESIGN_PLAN.md
