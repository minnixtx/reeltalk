#!/usr/bin/env bash
#
# Guard: refuse to push any commit carrying a co-author trailer.
#
# The commit-msg hook stops a trailer being *created*; this stops one arriving by
# another route -- amend, cherry-pick, merge, a rebased branch, or a commit made
# with --no-verify. It scans exactly the commits about to leave this machine.
#
# See .githooks/commit-msg for why a co-author trailer is harmful here.

set -uo pipefail

ZERO="0000000000000000000000000000000000000000"
blocked=0

# git feeds one line per ref being pushed:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a branch -- nothing to check.
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "$remote_sha" = "$ZERO" ]; then
    range="$local_sha"
  else
    range="${remote_sha}..${local_sha}"
  fi

  bad="$(git log -i --grep='co-authored-by' --pretty='      %h  %s' "$range" 2>/dev/null || true)"

  if [ -n "$bad" ]; then
    {
      echo ""
      echo "  PUSH REJECTED -- $remote_ref contains co-author trailer(s):"
      echo "$bad"
      echo ""
      echo "  Strip them before pushing, e.g.:"
      echo "    git filter-branch -f --msg-filter \\"
      echo "      'grep -viE \"^[[:space:]]*(co-?authored-by|coauthor-by)[[:space:]]*:\"' \\"
      echo "      <first-offender>~1..\${local_ref#refs/heads/}"
      echo ""
      echo "  Rule: PROGRESS.md -> 'Contributor attribution re-clean' (2026-09-20)."
      echo ""
    } >&2
    blocked=1
  fi
done

exit "$blocked"
